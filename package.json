{
  "name": "projen-modules",
  "description": "A collection of projen modules",
  "repository": {
    "type": "git",
    "url": "https://github.com/daveshepherd/projen-modules.git"
  },
  "scripts": {
    "audit": "projen audit",
    "build": "projen build",
    "bump": "projen bump",
    "bump:releasable-commits": "projen bump:releasable-commits",
    "clobber": "projen clobber",
    "compat": "projen compat",
    "compile": "projen compile",
    "default": "projen default",
    "docgen": "projen docgen",
    "eject": "projen eject",
    "eslint": "projen eslint",
    "package": "projen package",
    "package-all": "projen package-all",
    "package:js": "projen package:js",
    "package:python": "projen package:python",
    "post-compile": "projen post-compile",
    "post-upgrade": "projen post-upgrade",
    "pre-compile": "projen pre-compile",
    "release": "projen release",
    "test": "projen test",
    "test:watch": "projen test:watch",
    "unbump": "projen unbump",
    "upgrade": "projen upgrade",
    "watch": "projen watch",
    "projen": "projen"
  },
  "author": {
    "name": "Dave Shepherd",
    "email": "dave.shepherd@endor.me.uk",
    "organization": false
  },
  "devDependencies": {
    "@mrgrain/jsii-struct-builder": "^0.7.64",
    "@stylistic/eslint-plugin": "^2",
    "@types/jest": "^30",
    "@types/node": "^22",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "audit-ci": "^7",
    "commit-and-tag-version": "^13",
    "constructs": "10.8.1",
    "eslint": "^9",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30",
    "jest-junit": "^17",
    "jsii": "~6.0.0",
    "jsii-diff": "^1.141.0",
    "jsii-docgen": "^10.5.0",
    "jsii-pacmak": "^1.141.0",
    "jsii-rosetta": "~6.0.0",
    "projen": "0.104.0",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.0",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "constructs": "10.8.1",
    "projen": "0.* >=0.104.0"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "yarn",
      "version": "1.22.22",
      "onFail": "ignore"
    }
  },
  "main": "lib/index.js",
  "license": "Apache-2.0",
  "stability": "stable",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.0.0",
  "jest": {
    "coverageProvider": "v8",
    "testMatch": [
      "<rootDir>/@(src|test)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(src|test)/**/__tests__/**/*.ts?(x)",
      "<rootDir>/@(projenrc)/**/*(*.)@(spec|test).ts?(x)",
      "<rootDir>/@(projenrc)/**/__tests__/**/*.ts?(x)"
    ],
    "clearMocks": true,
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "clover",
      "cobertura",
      "text"
    ],
    "coverageDirectory": "coverage",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "test-reports"
        }
      ]
    ],
    "transform": {
      "^.+\\.[t]sx?$": [
        "ts-jest",
        {
          "tsconfig": "test/tsconfig.json"
        }
      ]
    }
  },
  "types": "lib/index.d.ts",
  "jsii": {
    "outdir": "dist",
    "targets": {
      "python": {
        "distName": "projen_modules",
        "module": "projen_modules"
      }
    },
    "tsconfig": "tsconfig.json",
    "validateTsconfig": "strict"
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
