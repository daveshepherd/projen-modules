  ".mergify.yml": "# ~~ Generated by projen. To modify, edit .projenrc.py and run "npx projen".

queue_rules:
  - name: default
    update_method: merge
    queue_conditions:
      - "#approved-reviews-by>=1"
      - -label~=(do-not-merge)
      - -draft
      - status-success=CodeQL
    merge_method: squash
    commit_message_format:
      title: pr-title
      body: pr-body
pull_request_rules:
  - name: Automatic merge on approval and successful build
    actions:
      queue:
        name: default
    conditions:
      - "#approved-reviews-by>=1"
      - -label~=(do-not-merge)
      - -draft
      - status-success=CodeQL
  - name: Automatic approval for projen upgrade pull requests
    conditions:
      - author=endor-projen[bot]
    actions:
      review:
        type: APPROVE
        message: Automatically approving projen upgrade
  - name: Assign PR when check fails
    conditions:
      - "#check-failure > 0"
    actions:
      assign:
        add_users:
          - daveshepherd
merge_queue:
  max_parallel_checks: 1
merge_protections_settings:
  reporting_method: deployments
",
