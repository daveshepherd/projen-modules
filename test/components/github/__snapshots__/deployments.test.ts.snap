exports[`Deployments chains a deploy job per environment after the release 1`] = `
"# ~~ Generated by projen. To modify, edit .projenrc.ts and run "npx projen".

name: release
run-name: \${{ inputs.dry_run && format('[DRY RUN] release by @{0}', github.actor) || '' }}
on:
  push:
    branches:
      - main
  workflow_dispatch:
    inputs:
      dry_run:
        description: Dry run (skip actual publishing)
        required: false
        type: boolean
concurrency:
  group: \${{ github.workflow }}
  cancel-in-progress: false
jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    outputs:
      latest_commit: \${{ steps.git_remote.outputs.latest_commit }}
      tag_exists: \${{ steps.check_tag_exists.outputs.exists }}
      artifact_id: \${{ steps.upload_artifact.outputs.artifact-id }}
    env:
      CI: "true"
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          fetch-depth: 0
      - name: Set git identity
        id: set_git_identity
        run: |-
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@v7.0.0
        with:
          cache: yarn
          package-manager-cache: true
      - name: Install dependencies
        id: install_dependencies
        run: yarn install --check-files --frozen-lockfile
      - name: release
        id: release
        run: npx projen release
      - name: Check if version has already been tagged
        id: check_tag_exists
        run: |-
          TAG=$(cat dist/releasetag.txt)
          ([ ! -z "$TAG" ] && git ls-remote -q --exit-code --tags origin $TAG && (echo "exists=true" >> $GITHUB_OUTPUT)) || (echo "exists=false" >> $GITHUB_OUTPUT)
          cat $GITHUB_OUTPUT
      - name: Check for new commits
        id: git_remote
        env:
          GITHUB_REF: \${{ github.ref }}
        run: |-
          echo "latest_commit=$(git ls-remote origin -h "$GITHUB_REF" | cut -f1)" >> $GITHUB_OUTPUT
          cat $GITHUB_OUTPUT
        shell: bash
      - name: Backup artifact permissions
        id: backup_artifact_permissions
        if: \${{ steps.git_remote.outputs.latest_commit == github.sha }}
        run: cd dist && getfacl -R . > permissions-backup.acl
        continue-on-error: true
      - name: Upload artifact
        id: upload_artifact
        if: \${{ steps.git_remote.outputs.latest_commit == github.sha }}
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: build-artifact
          path: dist
          overwrite: true
  deploy_staging:
    name: Deploy to Staging
    needs: release
    runs-on: ubuntu-latest
    permissions:
      id-token: write
    environment: staging
    if: needs.release.outputs.tag_exists != 'true'
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      - name: Download build artifacts
        id: download_build_artifacts
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: build-artifact
          path: dist
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020
        with:
          cache: yarn
      - name: Install dependencies
        id: install_dependencies
        run: yarn install --check-files --frozen-lockfile
      - name: configure aws credentials
        id: configure_aws_credentials
        uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd
        with:
          role-to-assume: \${{ secrets.AWS_DEPLOYMENT_ROLE_ARN }}
          role-session-name: my-app-deploy
          aws-region: eu-west-2
      - name: deploy
        id: deploy
        env:
          STAGE: staging
          EXAMPLE_SECRET: \${{ secrets.EXAMPLE_SECRET }}
        run: yarn deploy --require-approval never
  deploy_production:
    name: Deploy to Production
    needs:
      - release
      - deploy_staging
    runs-on: ubuntu-latest
    permissions:
      id-token: write
    environment: production
    if: needs.release.outputs.tag_exists != 'true'
    steps:
      - name: Checkout
        id: checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      - name: Download build artifacts
        id: download_build_artifacts
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: build-artifact
          path: dist
      - name: Setup Node.js
        id: setup_node_js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020
        with:
          cache: yarn
      - name: Install dependencies
        id: install_dependencies
        run: yarn install --check-files --frozen-lockfile
      - name: configure aws credentials
        id: configure_aws_credentials
        uses: aws-actions/configure-aws-credentials@e1253824e5c10ff9df46874f81ed3ec929e19cfd
        with:
          role-to-assume: \${{ secrets.AWS_DEPLOYMENT_ROLE_ARN }}
          role-session-name: my-app-deploy
          aws-region: eu-west-2
      - name: deploy
        id: deploy
        env:
          STAGE: production
          EXAMPLE_SECRET: \${{ secrets.EXAMPLE_SECRET }}
        run: yarn deploy --require-approval never
  release_github:
    name: Publish to GitHub Releases
    needs: release
    runs-on: ubuntu-latest
    permissions:
      contents: write
    if: needs.release.outputs.tag_exists != 'true' && needs.release.outputs.latest_commit == github.sha
    steps:
      - uses: actions/setup-node@v7.0.0
        with:
          node-version: lts/*
          package-manager-cache: false
      - name: Download build artifacts
        id: download_build_artifacts
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          artifact-ids: \${{ needs.release.outputs.artifact_id }}
          path: dist
      - name: Restore build artifact permissions
        id: restore_build_artifact_permissions
        run: cd dist && setfacl --restore=permissions-backup.acl
        continue-on-error: true
      - name: Release
        id: release
        if: \${{ !inputs.dry_run }}
        env:
          RELEASE_TAG_FILE: dist/releasetag.txt
          CHANGELOG_FILE: dist/changelog.md
          GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
        run: |-
          tag=$(cat "$RELEASE_TAG_FILE") &&
          gh release view "$tag" -R "$GITHUB_REPOSITORY" 2>/dev/null ||
          gh release create "$tag" -R "$GITHUB_REPOSITORY" -F "$CHANGELOG_FILE" -t "$tag" --target "$GITHUB_SHA"
"
`;

exports[`Deployments chains a deploy job per environment after the release 2`] = `
"<!-- ~~ Generated by projen. To modify, edit .projenrc.ts and run "npx projen". -->

# my-app

## Getting Started

\`\`\`sh
yarn install
npx projen build
\`\`\`

## CDK

Bootstrap each AWS account and region once:

\`\`\`sh
npx cdk bootstrap
\`\`\`

Deploy the app:

\`\`\`sh
npx projen deploy
\`\`\`

If the app has more than one stack, name the stacks to deploy or pass \`--all\`, as in \`npx projen deploy --all\`.

## Deployment

After each release, the release workflow deploys to these GitHub environments in order, each after the previous one succeeds:

| Environment | Region | Secrets |
| ----------- | ------ | ------- |
| staging | eu-west-2 | \`AWS_DEPLOYMENT_ROLE_ARN\`, \`EXAMPLE_SECRET\` |
| production | eu-west-2 | \`AWS_DEPLOYMENT_ROLE_ARN\`, \`EXAMPLE_SECRET\` |

Each environment needs these secrets set, the first being the ARN of a role that trusts GitHub's OIDC provider.

## GitHub Configuration

The one-off configuration that this repository needs on GitHub, such as the Mergify merge queue and the branch ruleset, is described in [docs/github-configuration.md](docs/github-configuration.md)."
`;
